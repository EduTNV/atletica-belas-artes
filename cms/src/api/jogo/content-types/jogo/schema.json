{
  "kind": "collectionType",
  "collectionName": "jogos",
  "info": {
    "singularName": "jogo",
    "pluralName": "jogos",
    "displayName": "Jogo"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "time_casa": {
      "type": "string",
      "required": true
    },
    "time_visitante": {
      "type": "string",
      "required": true
    },
    "modalidade": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::modalidade.modalidade",
      "inversedBy": "jogos"
    },
    "competicao": {
      "type": "string"
    },
    "fase": {
      "type": "string"
    },
    "data_hora": {
      "type": "datetime",
      "required": true
    },
    "local": {
      "type": "string"
    },
    "placar_casa": {
      "type": "integer"
    },
    "placar_visitante": {
      "type": "integer"
    },
    "status": {
      "type": "enumeration",
      "enum": ["proximo", "em_andamento", "finalizado"],
      "default": "proximo",
      "required": true
    }
  }
}
